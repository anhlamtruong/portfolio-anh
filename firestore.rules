rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Homepage view counter. Anyone can read it, and a write can only
    // add 1 to `count` (or create the doc with count = 1).
    match /views/portfolio-homepage {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    // Everything else is denied to client SDKs. Server code that needs
    // other collections (e.g. users) should use the Admin SDK.
  }
}
