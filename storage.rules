rules_version = '2';

// Public, read-only assets for the portfolio site.
// Files are uploaded from the Firebase Console, so the app never writes here.
service firebase.storage {
  match /b/{bucket}/o {
    // Skill logos listed on the homepage
    match /logos/{allPaths=**} {
      allow read;
    }

    // Resume and transcript PDFs linked from the site
    match /portfolio/{allPaths=**} {
      allow read;
    }

    // Videos and fonts used by Creata components
    match /creata/{allPaths=**} {
      allow read;
    }

    // Anything not matched above (including all writes) is denied.
  }
}
